' --------------------------------------------------------------------
' 1. REVISED USE CASE DIAGRAM
' --------------------------------------------------------------------
@startuml RTConnect_UseCase_Diagram
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 8

skinparam actor {
  BackgroundColor #E8F0FE
  BorderColor #1A73E8
}
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #5F6368
  ArrowColor #202124
}

actor "Warga" as Warga
actor "Ketua RT" as RT
actor "Pengguna" as User

Warga -up-|> User
RT -up-|> User

rectangle "Sistem RTConnect" {

  package "Modul Autentikasi & Akun" {
    usecase "UC-01: Registrasi Akun" as UC01
    usecase "UC-02: Login ke Sistem" as UC02
    usecase "UC-03: Mengelola Profil Pengguna" as UC03
  }

  package "Modul Administrasi Surat Pengantar" {
    usecase "UC-04: Mengajukan Surat Pengantar" as UC04
    usecase "UC-05: Mengisi Ulang Form (Revisi)" as UC05
    usecase "UC-06: Mengunduh Dokumen Surat Final (PDF)" as UC06
    usecase "UC-07: Meninjau Pengajuan Surat" as UC07
    usecase "UC-08: Menindaklanjuti Pengajuan (Setuju/Revisi/Tolak)" as UC08
    usecase "UC-09: Mengonfirmasi TTD Digital (Tempelan Gambar)" as UC09
    usecase "UC-10: Memperbarui Status Fisik (TTD Basah)" as UC10
  }

  package "Modul Layanan Informasi & AI Chatbot" {
    usecase "UC-11: Bertanya ke Chatbot Tanya RT" as UC11
    usecase "UC-12: Menjawab Eskalasi Pertanyaan Warga" as UC12
  }
}

' Relasi Pengguna (Umum)
User --> UC02
User --> UC03

' Relasi Warga
Warga --> UC01
Warga --> UC04
Warga --> UC05
Warga --> UC06
Warga --> UC11

' Relasi Ketua RT
RT --> UC07
RT --> UC08
RT --> UC09
RT --> UC10
RT --> UC12

' Dependensi / Relasi Antar Use Case
UC08 .left.> UC07 : <<include>>
UC08 ..> UC09 : <<extend>>\n[Metode = Digital]
UC08 ..> UC10 : <<extend>>\n[Metode = Basah]
UC05 ..> UC04 : <<extend>>\n[Status = Perlu Revisi]

@enduml

' --------------------------------------------------------------------
' 2. REVISED SEQUENCE DIAGRAM - LOGIN
' --------------------------------------------------------------------
@startuml RTConnect_Sequence_Login
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false

actor "Pengguna" as User
boundary ":HalamanLogin" as UI
control ":AuthController" as Ctrl
entity ":User" as EntUser
control ":SessionManager" as Session

User -> UI : Buka halaman login()
activate UI
UI --> User : Tampilkan form login (Email/NIK & Password)
deactivate UI

User -> UI : Submit kredensial (identity, password)
activate UI
UI -> Ctrl : authenticate(identity, password)
activate Ctrl

Ctrl -> Ctrl : validateInputFormat(identity, password)
alt Input Tidak Lengkap
    Ctrl --> UI : return ValidationError("Isian wajib diisi")
    UI --> User : Tampilkan notifikasi validasi
else Format Valid
    Ctrl -> EntUser : findByIdentity(identity)
    activate EntUser
    EntUser --> Ctrl : userRecord / null
    deactivate EntUser

    alt Akun Tidak Ditemukan
        Ctrl --> UI : return AuthError("Akun tidak terdaftar")
        UI --> User : Tampilkan pesan error akun tidak ditemukan
    else Akun Ditemukan
        Ctrl -> Ctrl : verifyPasswordHash(password, userRecord.password_hash)
        alt Password Salah
            Ctrl --> UI : return AuthError("Password salah")
            UI --> User : Tampilkan pesan peringatan password salah
        else Password Benar
            Ctrl -> Session : createSession(userRecord.user_id, userRecord.role)
            activate Session
            Session --> Ctrl : sessionToken
            deactivate Session

            Ctrl -> EntUser : updateLastLogin(userRecord.user_id, timestamp)
            activate EntUser
            EntUser --> Ctrl : success
            deactivate EntUser

            Ctrl --> UI : return Success(sessionToken, userRecord.role)
            alt Role == "warga"
                UI --> User : Alihkan ke Dashboard Warga (/warga/home)
            else Role == "rt"
                UI --> User : Alihkan ke Dashboard Ketua RT (/rt/pengajuan)
            end
        end
    end
end
deactivate Ctrl
deactivate UI

@enduml

' --------------------------------------------------------------------
' 3. REVISED SEQUENCE DIAGRAM - REGISTER
' --------------------------------------------------------------------
@startuml RTConnect_Sequence_Register
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false

actor "Warga" as User
boundary ":HalamanRegister" as UI
control ":AuthController" as Ctrl
entity ":User" as EntUser
control ":StorageService" as Storage

User -> UI : Buka halaman registrasi()
activate UI
UI --> User : Tampilkan formulir pendaftaran
deactivate UI

User -> UI : Input (NIK, Nama, Alamat, NoTelp, Email, Password, BerkasTTD)
activate UI
User -> UI : Klik "Daftar Akun"
UI -> Ctrl : register(registerData, signatureFile)
activate Ctrl

Ctrl -> Ctrl : validateForm(registerData)
alt Validasi Gagal (NIK != 16 digit / field kosong)
    Ctrl --> UI : return ValidationError(pesanError)
    UI --> User : Tampilkan pesan kesalahan field
else Format Valid
    Ctrl -> EntUser : checkNikExists(nik)
    activate EntUser
    EntUser --> Ctrl : isNikTaken
    deactivate EntUser

    alt NIK Sudah Terdaftar
        Ctrl --> UI : return ConflictError("NIK sudah terdaftar")
        UI --> User : Tampilkan notifikasi NIK terpakai
    else NIK Tersedia
        Ctrl -> EntUser : checkEmailExists(email)
        activate EntUser
        EntUser --> Ctrl : isEmailTaken
        deactivate EntUser

        alt Email Sudah Terdaftar
            Ctrl --> UI : return ConflictError("Email sudah terdaftar")
            UI --> User : Tampilkan notifikasi email terpakai
        else Email Tersedia
            Ctrl -> Storage : uploadSignature(signatureFile)
            activate Storage
            Storage --> Ctrl : signatureUrl
            deactivate Storage

            Ctrl -> Ctrl : hashPassword(password)
            Ctrl -> EntUser : createUser(data, signatureUrl, role="warga")
            activate EntUser
            EntUser --> Ctrl : newUserId
            deactivate EntUser

            Ctrl --> UI : return Success("Registrasi berhasil")
            UI --> User : Tampilkan notifikasi sukses & alihkan ke Halaman Login
        end
    end
end
deactivate Ctrl
deactivate UI

@enduml

' --------------------------------------------------------------------
' 4. REVISED SEQUENCE DIAGRAM - CHATBOT TANYA RT (RAG ARSITEKTUR)
' --------------------------------------------------------------------
@startuml RTConnect_Sequence_Chatbot_RAG
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false

actor "Warga" as Warga
boundary ":HalamanChatbot" as UI
control ":ChatbotController" as Ctrl
control ":VectorSearchService" as VectorService
entity ":KnowledgeChunk" as KB
control ":LLMService" as LLM
entity ":ChatLog" as Log

Warga -> UI : Ketik pertanyaan ("Syarat surat domisili?")
activate UI
UI -> Ctrl : sendMessage(session_id, user_id, message_text)
activate Ctrl

Ctrl -> Log : saveUserMessage(session_id, user_id, message_text)
activate Log
Log --> Ctrl : message_id
deactivate Log

Ctrl -> VectorService : searchRelevantChunks(message_text, top_k=3)
activate VectorService
VectorService -> VectorService : generateQueryEmbedding(message_text)
VectorService -> KB : querySimilarVectors(query_vector, similarity_threshold=0.70)
activate KB
KB --> VectorService : relevant_chunks, highest_score
deactivate KB
VectorService --> Ctrl : result_chunks, highest_score
deactivate VectorService

alt highest_score >= 0.70 (Informasi Ditemukan di Basis Pengetahuan)
    Ctrl -> LLM : generateGroundedAnswer(message_text, context_chunks)
    activate LLM
    LLM --> Ctrl : bot_reply_text
    deactivate LLM

    Ctrl -> Log : saveBotMessage(session_id, bot_reply_text, status="terjawab")
    activate Log
    Log --> Ctrl : success
    deactivate Log

    Ctrl --> UI : return ChatResponse(bot_reply_text, sources=result_chunks.metadata)
    UI --> Warga : Tampilkan balasan chatbot beserta sumber rujukan
else highest_score < 0.70 (Informasi Tidak Ditemukan / Out-of-Domain)
    Ctrl -> Ctrl : createEscalationSummary(message_text)
    Ctrl -> Log : saveBotMessage(session_id, bot_fallback_text, status="eskalasi")
    activate Log
    Log --> Ctrl : success
    deactivate Log

    Ctrl --> UI : return EscalationResponse(fallback_message, wa_link_rt)
    UI --> Warga : Tampilkan pesan maaf & tombol langsung menuju WhatsApp Ketua RT
end

deactivate Ctrl
deactivate UI

@enduml

' --------------------------------------------------------------------
' 5. REVISED SEQUENCE DIAGRAM - PENGAJUAN SURAT PENGANTAR (E2E)
' --------------------------------------------------------------------
@startuml RTConnect_Sequence_Pengajuan_Surat
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false

actor "Warga" as Warga
boundary ":FormPengajuan" as UIForm
control ":SuratController" as Ctrl
control ":AIGenerator" as AI
entity ":PengajuanSurat" as EntSurat
control ":NotificationService" as Notif
boundary ":DashboardRT" as UIRT
actor "Ketua RT" as RT

Warga -> UIForm : Isi form (jenis_surat, keperluan, metode_ttd, lampiran)
activate UIForm
Warga -> UIForm : Klik "Kirim Pengajuan"
UIForm -> Ctrl : submitPengajuan(dataPengajuan)
activate Ctrl

Ctrl -> EntSurat : saveInitialPengajuan(data, status="diajukan")
activate EntSurat
EntSurat --> Ctrl : pengajuan_id
deactivate EntSurat

Ctrl -> AI : generateDraftNarasi(keperluan, profilWarga)
activate AI
AI --> Ctrl : drafSuratKonten
deactivate AI

Ctrl -> EntSurat : updateDraftAI(pengajuan_id, drafSuratKonten)
Ctrl -> Notif : pushNotification(rt_id, "Pengajuan Baru Masuk")
Ctrl --> UIForm : return Success("Pengajuan berhasil dikirim")
UIForm --> Warga : Tampilkan status "Diajukan"
deactivate UIForm

... Ketua RT Membuka Sistem ...

RT -> UIRT : Buka detail pengajuan(pengajuan_id)
activate UIRT
UIRT -> Ctrl : getDetailPengajuan(pengajuan_id)
Ctrl -> EntSurat : findById(pengajuan_id)
EntSurat --> Ctrl : detailRecord
Ctrl --> UIRT : return detailRecord + draf_ai
UIRT --> RT : Tampilkan data pemohon & draf surat AI

alt RT Menyetujui Pengajuan
    RT -> UIRT : Klik "Setuju" & konfirmasi pengesahan
    UIRT -> Ctrl : approvePengajuan(pengajuan_id, metode_ttd)
    
    alt Metode == "Digital"
        Ctrl -> Ctrl : embedSignatureImage(pengajuan_id, rt_signature_url)
        Ctrl -> EntSurat : updateStatus(pengajuan_id, "selesai")
        Ctrl -> Notif : notifyWarga(warga_id, "Surat bertanda tangan digital siap diunduh")
        Ctrl --> UIRT : return "Surat resmi diterbitkan (Tempelan TTD Digital)"
    else Metode == "Basah"
        Ctrl -> EntSurat : updateStatus(pengajuan_id, "siap_diambil")
        Ctrl -> Notif : notifyWarga(warga_id, "Surat fisik siap diambil di RT")
        Ctrl --> UIRT : return "Status diubah menjadi Siap Diambil"
    end
else RT Meminta Revisi
    RT -> UIRT : Klik "Revisi" & isi catatan perbaikan
    UIRT -> Ctrl : requestRevision(pengajuan_id, catatan)
    Ctrl -> EntSurat : updateStatus(pengajuan_id, "perlu_revisi", catatan)
    Ctrl -> Notif : notifyWarga(warga_id, "Pengajuan memerlukan revisi")
    Ctrl --> UIRT : return "Permintaan revisi terkirim"
else RT Menolak Pengajuan
    RT -> UIRT : Klik "Tolak" & isi alasan penolakan
    UIRT -> Ctrl : rejectPengajuan(pengajuan_id, alasan)
    Ctrl -> EntSurat : updateStatus(pengajuan_id, "ditolak", alasan)
    Ctrl -> Notif : notifyWarga(warga_id, "Pengajuan ditolak")
    Ctrl --> UIRT : return "Pengajuan ditolak"
end

deactivate Ctrl
deactivate UIRT

@enduml

' --------------------------------------------------------------------
' 6. REVISED ACTIVITY DIAGRAM - PENGAJUAN SURAT PENGANTAR
' --------------------------------------------------------------------
@startuml RTConnect_Activity_Pengajuan_Surat
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false

|Warga|
start
:Buka menu "Ajukan Surat";
:Pilih jenis surat & keperluan;
:Pilih metode tanda tangan\n(Digital Tempelan Gambar / Basah);
:Unggah dokumen pendukung (opsional);
:Tekan tombol "Kirim Pengajuan";

|Sistem|
:Validasi kelengkapan isian;
if (Isian Lengkap & Valid?) then (Ya)
  :Simpan pengajuan (Status: "Diajukan");
  :Formulasi draf surat via Generative AI;
  :Kirim notifikasi pengajuan baru ke Ketua RT;
else (Tidak)
  :Tampilkan pesan perbaikan field;
  stop
endif

|Ketua RT|
:Buka notifikasi & antrean pengajuan;
:Tinjau data warga, lampiran & draf AI;

if (Keputusan Tindak Lanjut?) then (Setuju)
  |Sistem|
  :Tetapkan Nomor Surat Resmi;
  if (Metode Tanda Tangan?) then (Digital (Tempelan Gambar))
    |Ketua RT|
    :Konfirmasi penggunaan TTD Digital;
    |Sistem|
    :Sematkan gambar stempel tanda tangan Ketua RT;
    :Generate berkas PDF final;
    :Ubah status menjadi "Selesai";
    |Warga|
    :Terima notifikasi;
    :Unduh berkas PDF resmi;
  else (Basah)
    |Ketua RT|
    :Cetak berkas surat fisik;
    :Tandatangani surat dengan pulpen;
    :Tekan tombol "Konfirmasi Siap Diambil";
    |Sistem|
    :Ubah status menjadi "Siap Diambil";
    |Warga|
    :Terima notifikasi jadwal pickup;
    :Ambil fisik surat di rumah RT;
  endif
elseif (Perlu Revisi)
  |Ketua RT|
  :Tuliskan catatan revisi spesifik;
  |Sistem|
  :Ubah status menjadi "Perlu Revisi";
  |Warga|
  :Terima notifikasi revisi;
  :Perbaiki isian pada form perbaikan;
  :Kirim ulang pengajuan;
  detach
else (Tolak)
  |Ketua RT|
  :Tuliskan alasan penolakan;
  |Sistem|
  :Ubah status menjadi "Ditolak";
  |Warga|
  :Terima notifikasi penolakan;
endif

|Warga|
stop

@enduml

' --------------------------------------------------------------------
' 7. REVISED ACTIVITY DIAGRAM - CHATBOT TANYA RT
' --------------------------------------------------------------------
@startuml RTConnect_Activity_Chatbot
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false

|Warga|
start
:Buka tab layanan "Tanya RT";
:Ketikkan pertanyaan pada input chat;
:Tekan tombol kirim pesan;

|Sistem (RAG)|
:Simpan pesan warga ke ChatLog;
:Generate vector embedding dari pertanyaan;
:Hitung Cosine Similarity dengan Knowledge Chunks;

if (Skor Relevansi >= 0.70?) then (Ya - Jawaban Ditemukan)
  :Ambil potongan dokumen regulasi RT terkait;
  :Sintesis jawaban akurat melalui LLM;
  :Tampilkan gelembung jawaban + Badge Sumber;
  |Warga|
  :Membaca informasi resmi RT;
  stop
else (Tidak - Di Luar Domain)
  |Sistem (RAG)|
  :Susun ringkasan pertanyaan warga;
  :Tampilkan pesan maaf & kartu eskalasi;
  :Buat tautan WhatsApp otomatis (wa.me);
  |Warga|
  :Klik tombol "Hubungi Ketua RT via WhatsApp";
  :Dialihkan ke aplikasi WhatsApp Ketua RT;
  :Kirim pesan langsung ke Ketua RT;
  stop
endif

@enduml
